# Copy to private-access.tf to include this file in the Terraform configuration.
data "azurerm_virtual_network" "existing" {
  name                = var.virtual_network_name
  resource_group_name = var.checkpoint_resource_group_name
}

data "azurerm_subnet" "existing_endpoints" {
  name                 = "private-endpoints"
  virtual_network_name = data.azurerm_virtual_network.existing.name
  resource_group_name  = var.checkpoint_resource_group_name
}

# Cosmos NoSQL uses this exact private DNS zone name.
resource "azurerm_private_dns_zone" "cosmos" {
  name                = "privatelink.documents.azure.com"
  resource_group_name = var.resource_group_name
  tags                = local.common_tags
}

# This link makes the zone available to the Function's existing VNet.
resource "azurerm_private_dns_zone_virtual_network_link" "cosmos" {
  name                 = "cloudops-cosmos"
  private_dns_zone_id  = azurerm_private_dns_zone.cosmos.id
  virtual_network_id   = data.azurerm_virtual_network.existing.id
  registration_enabled = false
  tags                 = local.common_tags
}

resource "azurerm_private_endpoint" "cosmos" {
  name                = "pe-${var.account_name}"
  resource_group_name = var.resource_group_name
  location            = var.location
  subnet_id           = data.azurerm_subnet.existing_endpoints.id

  private_service_connection {
    name                           = "cosmos-sql"
    private_connection_resource_id = azurerm_cosmosdb_account.cosmos.id
    subresource_names              = ["Sql"]
    is_manual_connection           = false
  }

  # Azure creates and maintains the endpoint's DNS records through this group.
  private_dns_zone_group {
    name                 = "cosmos"
    private_dns_zone_ids = [azurerm_private_dns_zone.cosmos.id]
  }
  tags = local.common_tags
}
